# Caddy reverse-proxy config for FinEstDB. Caddy provisions and renews TLS
# automatically for the named domain. Install to /etc/caddy/Caddyfile.
#
# Caddy sets X-Forwarded-For on the proxied request; the app trusts it because
# the hop arrives from loopback (and FINNESTDB_TRUST_FORWARD_HEADERS=1 is set
# in finnestdb.service), so per-client rate limiting keys on real client IPs.
finne.st {
	encode gzip

	# Emit request status and end-to-end duration to the Caddy service logs.
	# Access logs do not include request bodies, so pasted learner text is not
	# retained as monitoring data.
	log {
		output stdout
		format json
	}

	# Body cap at the edge, matching the app's own request-size limits, so
	# oversized uploads die before reaching Go.
	request_body {
		max_size 20MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' http://127.0.0.1:8765"
	}

	reverse_proxy 127.0.0.1:8080
}
