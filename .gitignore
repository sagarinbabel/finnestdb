# Single root for every gitignored runtime artifact: dictionary corpora,
# Gutenberg silver, generated lemmatizer tables, the UD treebank cache, and
# any local-only parser-eval gold (NC-licensed ET dev/test, train splits).
# See docs/ARTIFACT_POLICY.md and docs/data_enhancement.md for the full
# inventory. `tar czf finnestdb-bootstrap.tgz localdata/ finnestdb.db`
# captures the entire bootstrap state for handoff to a teammate.
localdata/

# Legacy data/ paths (pre-2026-05-07) are kept here as belt-and-braces in
# case a stale workflow still writes to them. New code MUST write to
# localdata/ instead - there is no second data root.
data/
# Exception: the Embedded Text catalog embeds checked-in metadata + fixtures
# from internal/catalog/data/ via go:embed. This is tracked package data, not a
# runtime artifact, so it must survive the broad data/ rule above.
!internal/catalog/data/
!internal/catalog/data/**

# Claude Code
.claude/

# Autoresearch transient experiment logs (commit specific runs explicitly)
experiments/test*.jsonl
experiments/autoresearch.jsonl

